{
  "expo": {
    "name": "DragonFocus",
    "slug": "DragonFocus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/expoImages/icon.png",
    "scheme": "dragonfocus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/expoImages/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/expoImages/android-icon-foreground.png",
        "backgroundImage": "./assets/images/expoImages/android-icon-background.png",
        "monochromeImage": "./assets/images/expoImages/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.masterj.DragonFocus"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/expoImages/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/expoImages/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ab97662-85ad-40bc-81b8-bb5f623f6a41"
      }
    }
  }
}
